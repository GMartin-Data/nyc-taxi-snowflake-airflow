# Copy to .env at the repository root and fill in. .env is ignored by Git.
# Load it with: uv run --env-file .env python ingestion/load_month.py 2025-01

# Account identifier, ORGANISATION-ACCOUNT form (not the user name)
SNOWFLAKE_ACCOUNT=ORGANISATION-ACCOUNT

# Private key of the service user AIRFLOW_SVC; uncomment to change the default
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake/rsa_key.p8